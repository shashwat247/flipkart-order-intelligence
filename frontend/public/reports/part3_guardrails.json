{
  "injection_patterns": [
    {
      "name": "ignore-previous-instructions",
      "pattern": "ignore\\s+(?:all\\s+|any\\s+|the\\s+)?(?:previous|prior|earlier|above)\\s+(?:instruction|instructions|prompt|prompts|message|messages|context)"
    },
    {
      "name": "ignore-all-rules",
      "pattern": "ignore\\s+(?:all\\s+|any\\s+|the\\s+)?(?:rule|rules|guideline|guidelines|restriction|restrictions|policy\\s+constraints)"
    },
    {
      "name": "ignore-system-prompt",
      "pattern": "ignore\\s+(?:your|the)\\s+system\\s+prompt"
    },
    {
      "name": "disregard-instructions",
      "pattern": "disregard\\s+(?:all\\s+|any\\s+|the\\s+|your\\s+)?(?:previous|prior|earlier|above)?\\s*(?:instruction|instructions|rule|rules|prompt)"
    },
    {
      "name": "forget-your-instructions",
      "pattern": "forget\\s+(?:all\\s+|your\\s+|the\\s+)?(?:previous\\s+)?(?:instruction|instructions|rule|rules|training|prompt)"
    },
    {
      "name": "pretend-you-are",
      "pattern": "pretend\\s+(?:you\\s+are|to\\s+be|you're)"
    },
    {
      "name": "act-as",
      "pattern": "act\\s+as\\s+(?:if\\s+you|though\\s+you|a\\s+|an\\s+)"
    },
    {
      "name": "you-are-now",
      "pattern": "you\\s+are\\s+now\\s+(?:a|an|no\\s+longer)"
    },
    {
      "name": "reveal-system-prompt",
      "pattern": "(?:reveal|show|print|repeat|output|display)\\s+(?:me\\s+)?(?:your|the)\\s+(?:system\\s+prompt|initial\\s+prompt|instructions|hidden\\s+prompt|prompt)"
    },
    {
      "name": "developer-mode",
      "pattern": "(?:developer|debug|god|admin)\\s+mode"
    },
    {
      "name": "jailbreak",
      "pattern": "\\bjailbreak\\b"
    },
    {
      "name": "bypass-guardrails",
      "pattern": "(?:bypass|override|disable)\\s+(?:your\\s+|the\\s+|all\\s+)?(?:guardrail|guardrails|safety|filter|filters|restriction|restrictions)"
    },
    {
      "name": "do-not-follow-instructions",
      "pattern": "do\\s+not\\s+(?:follow|obey)\\s+(?:your|the)\\s+(?:instruction|instructions|rules)"
    }
  ],
